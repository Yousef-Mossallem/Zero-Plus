# =========================================================
# ZeroPlus - Git Ignore
# =========================================================

# =========================================================
# Node.js
# =========================================================

**/node_modules/
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/pnpm-debug.log*

# Build / production output
**/dist/
**/build/
**/.vite/
**/.next/
**/out/

# =========================================================
# Python
# =========================================================

# Virtual environments
ai-service/venv/
**/.venv/
**/venv/
**/env/

# Python cache
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class

# Python build / packaging
*.egg
*.egg-info/
dist/
build/
.wheels/

# =========================================================
# Environment Variables
# =========================================================

# .env files are INTENTIONALLY NOT ignored
