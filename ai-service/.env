# ============================================================
# Zero Plus — AI Service
# .env.example
# Copy to .env and fill real values
# ============================================================

# ---------- Application ----------
APP_NAME=zero-plus-ai
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true
LOG_LEVEL=INFO

# ---------- Security / Internal ----------
# Shared secret between Gateway and AI Service (optional but recommended)
AI_INTERNAL_TOKEN=change-me-to-a-long-random-string

# ---------- Redis ----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_SSL=false

# Cache TTL for /analyze results (seconds) — matches dossier (10s)
AI_CACHE_TTL_SEC=10

# Session history TTL (how long we remember a session for drift)
SESSION_TTL_SEC=1800

# Max feature vectors kept per session
SESSION_HISTORY_SIZE=20

# ---------- Model persistence ----------
# Folder where per-org models are saved
MODEL_STORE_PATH=./models_store

# How often to persist a model to disk (number of learn_one calls)
MODEL_SAVE_EVERY_N=50

# ---------- Decision thresholds (tunable later per org) ----------
# Anomaly score above this → strong suspicion
ANOMALY_HIGH_THRESHOLD=0.75
ANOMALY_MEDIUM_THRESHOLD=0.45

# Session drift above this → behavior changed significantly
SESSION_DRIFT_HIGH_THRESHOLD=0.60
SESSION_DRIFT_MEDIUM_THRESHOLD=0.35

# When clearance is valid + high drift/anomaly → recommend revoke
REVOKE_ON_HIGH_DRIFT=true

# ---------- Path sensitivity (can be overridden later from Backend) ----------
# Comma-separated paths considered high sensitivity
HIGH_SENSITIVITY_PATHS=/login,/checkout,/api/auth,/admin,/wp-login.php,/signin,/signup
MEDIUM_SENSITIVITY_PATHS=/api/,/cart,/account,/profile,/payment

# ---------- Initial training profile ----------
# small | medium | large  (used when a brand-new org appears)
DEFAULT_ORG_SIZE=medium

# ---------- Optional: Backend connection (for future use) ----------
BACKEND_BASE_URL=http://127.0.0.1:3000
BACKEND_INTERNAL_TOKEN=

# ---------- CORS (only if you ever call AI directly from browser — normally no) ----------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173