// ==================================================================
// Zero Plus - Database Schema (Professional & Complete)
// Prisma 7.x / 6.x compatible
// ==================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================================================================
// ENUMS
// ==================================================================

enum UserRole {
  OWNER
  ADMIN
  ANALYST
  VIEWER
}

enum ServerStatus {
  PENDING
  ONLINE
  DEGRADED
  OFFLINE
  MAINTENANCE
}

enum Decision {
  ALLOW
  RATE_LIMIT
  CHALLENGE
  BLOCK
}

enum BanStatus {
  NONE
  TEMPORARY
  PERMANENT
}

enum IpType {
  RESIDENTIAL
  MOBILE
  DATACENTER
  VPN_PROXY
  TOR
  UNKNOWN
}

enum ThreatCategory {
  DDOS_BURST
  BOTNET
  BRUTE_FORCE
  SCRAPER
  SUSPICIOUS_BEHAVIOR
  KNOWN_MALICIOUS
  SMOKESCREEN
  OTHER
}

enum NotificationType {
  DDOS_START
  NEW_BLOCK
  CRITICAL_REPUTATION
  SERVER_CAPACITY_WARNING
  SERVER_RECOVERY
  POLICY_CHANGED
  SYSTEM
}

enum ReportStatus {
  PENDING
  GENERATING
  READY
  FAILED
}

enum ChallengeType {
  JS_SILENT
  RATE_LIMIT_SOFT
  CAPTCHA_FALLBACK
}

enum SimulationPattern {
  NORMAL
  SUSPICIOUS_BURST
  REPEATED_REQUESTS
  UNUSUAL_BEHAVIOR
  KNOWN_TEST_SOURCE
}

// ==================================================================
// CORE TENANT MODELS
// ==================================================================

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  plan      String   @default("free")
  isActive  Boolean  @default(true)

  users              User[]
  servers            Server[]
  securityEvents     SecurityEvent[]
  reputationEntries  ReputationEntry[]
  policies           Policy?
  notifications      Notification[]
  reports            Report[]
  simulationRuns    SimulationRun[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
}

model User {
  id             String    @id @default(uuid())
  email          String    @unique
  passwordHash   String
  fullName       String
  role           UserRole  @default(OWNER)
  isActive       Boolean   @default(true)
  lastLoginAt    DateTime?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([email])
}

// ==================================================================
// PROTECTED SERVERS
// ==================================================================

model Server {
  id                   String       @id @default(uuid())
  domain               String
  originIp             String
  originPort           Int          @default(443)
  status               ServerStatus @default(PENDING)

  maxRequestsPerSecond Int?
  cpuCores             Int?
  ramMb                Int?
  avgResponseTimeMs    Int?
  currentLoadPercent   Float?
  lastHealthCheckAt    DateTime?

  dnsVerified          Boolean      @default(false)
  originReachable      Boolean      @default(false)
  sslEnabled           Boolean      @default(true)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  securityEvents SecurityEvent[]
  simulationRuns SimulationRun[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, domain])
  @@index([organizationId])
  @@index([status])
}

// ==================================================================
// REPUTATION SYSTEM
// ==================================================================

model ReputationEntry {
  id                String    @id @default(uuid())
  ipAddress         String
  deviceFingerprint String?
  ja3Fingerprint    String?
  ja4Fingerprint    String?

  countryCode       String?
  asn               Int?
  asOrg             String?
  ipType            IpType    @default(UNKNOWN)

  score             Int       @default(1)
  banStatus         BanStatus @default(NONE)
  bannedUntil       DateTime?
  failedChecksCount Int       @default(0)
  successfulChecks  Int       @default(0)
  totalRequests     Int       @default(0)

  lastPath          String?
  lastUserAgent     String?
  avgRequestRate    Float?
  isKnownBotnet     Boolean   @default(false)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  securityEvents SecurityEvent[]
  challenges     ChallengeLog[]

  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([organizationId, ipAddress])
  @@index([organizationId])
  @@index([banStatus])
  @@index([score])
  @@index([ja3Fingerprint])
  @@index([ja4Fingerprint])
  @@index([ipType])
}

// ==================================================================
// SECURITY EVENTS
// ==================================================================

model SecurityEvent {
  id              String   @id @default(uuid())

  ipAddress       String
  path            String
  method          String
  userAgent       String?
  referer         String?
  requestId       String?

  riskScore       Int
  anomalyScore    Float?
  confidence      Float?

  decision        Decision
  reasonSummary   String?
  reasonDetails   Json?

  countryCode     String?
  asn             Int?
  ipType          IpType?
  isChallenged    Boolean  @default(false)
  challengePassed Boolean?

  serverId            String
  server              Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  reputationEntryId   String?
  reputationEntry     ReputationEntry? @relation(fields: [reputationEntryId], references: [id])

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([serverId])
  @@index([ipAddress])
  @@index([decision])
  @@index([riskScore])
  @@index([createdAt])
}

// ==================================================================
// CHALLENGE LOGS
// ==================================================================

model ChallengeLog {
  id                String        @id @default(uuid())
  challengeType     ChallengeType
  passed            Boolean
  durationMs        Int?
  failureReason     String?

  reputationEntryId String
  reputationEntry   ReputationEntry @relation(fields: [reputationEntryId], references: [id], onDelete: Cascade)

  organizationId String
  createdAt      DateTime @default(now())

  @@index([reputationEntryId])
  @@index([organizationId])
  @@index([passed])
}

// ==================================================================
// POLICIES
// ==================================================================

model Policy {
  id                   String   @id @default(uuid())

  allowMaxScore        Int      @default(30)
  rateLimitMaxScore    Int      @default(60)
  challengeMaxScore    Int      @default(80)

  rateLimitRequests    Int      @default(30)
  rateLimitWindowSec   Int      @default(60)
  rateLimitRps         Int      @default(100)

  autoBanAfterFails    Int      @default(2)
  temporaryBanMinutes  Int      @default(120)
  permanentBanMinScore Int      @default(9)

  enableJsChallenge    Boolean  @default(true)
  enableAiAnomaly      Boolean  @default(true)

  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==================================================================
// NOTIFICATIONS
// ==================================================================

model Notification {
  id             String           @id @default(uuid())
  type           NotificationType
  title          String
  message        String
  severity       Int              @default(1)
  isRead         Boolean          @default(false)
  metadata       Json?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([isRead])
  @@index([createdAt])
}

// ==================================================================
// REPORTS
// ==================================================================

model Report {
  id             String       @id @default(uuid())
  title          String
  status         ReportStatus @default(PENDING)
  periodStart    DateTime
  periodEnd      DateTime
  content        String?
  summary        String?
  eventCount     Int          @default(0)
  blockedCount   Int          @default(0)
  metadata       Json?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([status])
}

// ==================================================================
// SIMULATION LAB
// ==================================================================

model SimulationRun {
  id             String            @id @default(uuid())
  pattern        SimulationPattern
  status         String            @default("running")
  targetRps      Int
  durationSec    Int?
  totalSent      Int               @default(0)
  totalBlocked   Int               @default(0)
  totalAllowed   Int               @default(0)

  serverId       String
  server         Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  startedAt      DateTime @default(now())
  stoppedAt      DateTime?

  @@index([organizationId])
  @@index([serverId])
  @@index([status])
}