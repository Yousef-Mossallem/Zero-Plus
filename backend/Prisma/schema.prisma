// ==================================================================
// Zero Plus - Database Schema (Final)
// Prisma 7.x / 6.x compatible
// Shared / Collective Immunity parts are commented out for now
// ==================================================================

generator client {
  provider = "prisma-client-js"
  // output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  // url      = env("DATABASE_URL")
}

// ==================================================================
// ENUMS
// ==================================================================

enum UserRole {
  OWNER     // أول شخص عمل الحساب - صلاحيات كاملة
  ADMIN     // صلاحيات إدارية كاملة داخل الشركة
  ANALYST   // يشوف كل حاجة ويقدر يعدل Policies لكن مش يدير Users
  VIEWER    // مشاهدة فقط (Live Traffic + Events + Reports)
}

enum ServerStatus {
  PENDING     // اتضاف لسه، النظام بيفحص الـ Origin أول مرة
  ONLINE      // شغال وسعته معروفة
  DEGRADED    // بيرد بس بطيء أو فيه مشاكل جزئية
  OFFLINE     // مش بيرد
  MAINTENANCE // الشركة حاطاه في صيانة يدوي
}

enum ServerMode {
  PROTECT       // الحماية شغالة فعليًا (تحظر وتحدد المعدل)
  MONITOR_ONLY  // تسجّل القرارات بس من غير ما تنفذها (مفيد أول ما الشركة تبدأ)
}

enum Decision {
  ALLOW
  MONITOR       // سماح مع مراقبة (من الدوسيه: 31-60 مراقبة أو تحديد معدل)
  RATE_LIMIT
  CHALLENGE     // اختبار متقدم بعد الاختبار الأساسي
  BLOCK
}

enum BanStatus {
  NONE
  TEMPORARY
  PERMANENT
}

enum IpType {
  RESIDENTIAL   // منزل
  MOBILE
  DATACENTER
  VPN_PROXY
  TOR
  UNKNOWN
}

enum ThreatCategory {
  DDOS_BURST
  BOTNET
  BRUTE_FORCE
  SCRAPER
  SUSPICIOUS_BEHAVIOR
  KNOWN_MALICIOUS
  SMOKESCREEN     // استخدام DDoS كستار دخاني
  OTHER
}

enum NotificationType {
  DDOS_START
  NEW_BLOCK
  CRITICAL_REPUTATION
  SERVER_CAPACITY_WARNING
  // THREAT_INTEL_UPDATE   // ← مش هيستخدم دلوقتي
  SERVER_RECOVERY
  POLICY_CHANGED
  SYSTEM
}

enum ReportStatus {
  PENDING
  GENERATING
  READY
  FAILED
}

enum ChallengeType {
  JS_SILENT         // الاختبار الصامت الأساسي (لكل الزوار الجدد)
  TLS_FINGERPRINT   // بصمة JA3/JA4 (اختبار متقدم للسمعة السيئة)
  RATE_LIMIT_SOFT
  CAPTCHA_FALLBACK  // احتياطي لو احتجنا (مش أساسي)
}

// أي خطوة من السلّم هي اللي اتخذت القرار
enum DetectionStage {
  BAN_LIST          // L0: الجهاز محظور
  PASS_TOKEN        // معاه تصريح صالح من اختبار سابق
  IP_LOOKUP         // L1: بحث الـ IP (ASN / Data Center)
  JS_CHALLENGE      // L2: الاختبار الصامت
  HISTORY_MATCH     // L3: مطابقة (IP + بصمة + دولة) مع السجل
  DEEP_COMPARISON   // L4: مقارنة أعمق
  TLS_FINGERPRINT   // L5: بصمة التشفير
  AI_ANOMALY        // L6: شذوذ من الـ AI
  HARD_LIMIT        // تجاوز الحد الأقصى للطلبات
  POLICY            // قرار الـ Policy النهائي من الـ Risk Score
}

enum SimulationPattern {
  NORMAL
  SUSPICIOUS_BURST
  REPEATED_REQUESTS
  UNUSUAL_BEHAVIOR
  KNOWN_TEST_SOURCE
}

enum SimulationStatus {
  RUNNING
  STOPPED
  COMPLETED
  FAILED
}

// ==================================================================
// CORE TENANT MODELS
// ==================================================================

model Organization {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique          // zeroplus.com/acme مثلاً
  plan        String   @default("free") // free / pro / enterprise (مستقبلي)
  isActive    Boolean  @default(true)

  // علاقات
  users               User[]
  servers             Server[]
  securityEvents      SecurityEvent[]
  reputationEntries   ReputationEntry[]
  challengeLogs       ChallengeLog[]
  policy              Policy?
  notifications       Notification[]
  reports             Report[]
  simulationRuns      SimulationRun[]
  // sharedThreatMatches SharedThreatMatch[] // ← مش هيستخدم دلوقتي (Collective Immunity)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
}

model User {
  id             String    @id @default(uuid())
  email          String    @unique
  passwordHash   String
  fullName       String
  role           UserRole  @default(OWNER)
  isActive       Boolean   @default(true)
  lastLoginAt    DateTime?

  // للـ Adaptive Dashboard Engine (القسم 8): ترتيب الواجهة حسب استخدام المستخدم
  uiPreferences  Json?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
}

// ==================================================================
// PROTECTED SERVERS
// ==================================================================

model Server {
  id                   String       @id @default(uuid())

  // unique على مستوى النظام كله (مش لكل شركة) لأن الـ Gateway بيدوّر بالـ Host بس،
  // ولمنع شركة من تسجيل دومين شركة تانية. خزّنه lowercase دايمًا.
  domain               String       @unique
  originIp             String       // الـ IP الحقيقي للسيرفر الأصلي
  originPort           Int          @default(443)
  status               ServerStatus @default(PENDING)
  mode                 ServerMode   @default(PROTECT)

  // معلومات السعة الحقيقية (بتتحدد من Health Check)
  maxRequestsPerSecond Int?
  cpuCores             Int?
  ramMb                Int?
  avgResponseTimeMs    Int?
  currentLoadPercent   Float?       // 0-100
  lastHealthCheckAt    DateTime?

  // DNS & Verification (القسم 14)
  verificationToken    String       @default(uuid()) // الشركة تحطه في DNS TXT لإثبات ملكية الدومين
  dnsVerified          Boolean      @default(false)
  dnsVerifiedAt        DateTime?
  gatewayReachable     Boolean      @default(false)
  originReachable      Boolean      @default(false)
  sslEnabled           Boolean      @default(true)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  securityEvents SecurityEvent[]
  simulationRuns SimulationRun[]
  challengeLogs  ChallengeLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([status])
}

// ==================================================================
// REPUTATION SYSTEM (القلب النابض)
// بيتنشئ Lazy: عند أول فشل أو شك، مش لكل زائر
// ==================================================================

model ReputationEntry {
  id                  String    @id @default(uuid())
  ipAddress           String
  deviceFingerprint   String?   // بصمة الجهاز (Canvas + WebGL + Fonts...)
  ja3Fingerprint      String?   // TLS JA3
  ja4Fingerprint      String?   // TLS JA4 (أحدث وأدق)

  // معلومات جغرافية وشبكة
  countryCode         String?   // EG, US, RU...
  asn                 Int?
  asOrg               String?
  ipType              IpType    @default(UNKNOWN)

  // نظام السمعة المتدرج
  score               Int       @default(1)   // 1 = بريء نسبياً → 10 = أسوأ حالة
  banStatus           BanStatus @default(NONE)
  bannedUntil         DateTime? // لو TEMPORARY
  bannedAt            DateTime?
  banReason           String?
  isManualBan         Boolean   @default(false) // حظر يدوي من الـ Dashboard
  isAllowlisted       Boolean   @default(false) // جهاز موثوق (مراقبة، شريك...) ما يتحظرش

  failedChecksCount   Int       @default(0)   // كام مرة فشل اختبارات
  successfulChecks    Int       @default(0)
  totalRequests       Int       @default(0)
  lastFailedAt        DateTime?               // لتقليل السمعة تدريجيًا مع الوقت

  // سلوك
  lastPath            String?
  lastUserAgent       String?
  avgRequestRate      Float?    // متوسط الطلبات في الدقيقة
  isKnownBotnet       Boolean   @default(false)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  securityEvents SecurityEvent[]
  challenges     ChallengeLog[]

  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([organizationId, ipAddress])
  @@index([organizationId])
  @@index([banStatus])
  @@index([bannedUntil])
  @@index([score])
  @@index([deviceFingerprint])
  @@index([ja3Fingerprint])
  @@index([ja4Fingerprint])
  @@index([ipType])
}

// ==================================================================
// SECURITY EVENTS (كل طلب اتاخد عليه قرار)
// Immutable: مفيش update ولا delete
// ==================================================================

model SecurityEvent {
  id              String   @id @default(uuid())

  // بيانات الطلب الأساسية
  ipAddress       String
  path            String
  method          String
  userAgent       String?
  referer         String?
  requestId       String?  // ID داخلي من الـ Gateway للتتبع

  // الإشارات المجمعة (Signals)
  riskScore       Int      // 0-100
  anomalyScore    Float?   // من الـ AI Service (0.0 - 1.0)
  confidence      Float?   // ثقة الموديل

  decision        Decision
  decidedAtStage  DetectionStage? // أي خطوة من السلّم اتخذت القرار
  reasonSummary   String?  // "IP Datacenter + High Rate + Bad History"
  reasonDetails   Json?    // تفاصيل كاملة للإشارات (مرنة)
  processingTimeMs Int?    // زمن المعالجة (الهدف 10-50ms)

  // معلومات إضافية
  countryCode     String?
  asn             Int?
  ipType          IpType?
  isChallenged    Boolean  @default(false)
  challengeType   ChallengeType?
  challengePassed Boolean?

  // علاقات
  serverId            String
  server              Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  reputationEntryId   String?
  reputationEntry     ReputationEntry? @relation(fields: [reputationEntryId], references: [id])

  reports             Report[]

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([serverId])
  @@index([ipAddress])
  @@index([decision])
  @@index([riskScore])
  @@index([createdAt])
  // كل استعلام في الـ Dashboard بيبدأ بـ organizationId ويترتب بالتاريخ
  @@index([organizationId, createdAt])
  @@index([serverId, createdAt])
}

// ==================================================================
// CHALLENGE LOGS (تتبع اختبارات التحقق)
// ==================================================================

model ChallengeLog {
  id              String        @id @default(uuid())
  challengeType   ChallengeType
  passed          Boolean
  durationMs      Int?          // قد إيه خد عشان ينفذ الاختبار (السرعة الغريبة = شك)
  failureReason   String?

  reputationEntryId String
  reputationEntry   ReputationEntry @relation(fields: [reputationEntryId], references: [id], onDelete: Cascade)

  serverId        String?
  server          Server?       @relation(fields: [serverId], references: [id], onDelete: SetNull)

  organizationId  String
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt       DateTime      @default(now())

  @@index([reputationEntryId])
  @@index([organizationId])
  @@index([serverId])
  @@index([passed])
}

// ==================================================================
// POLICIES (إعدادات القرار الخاصة بكل شركة - سجل واحد لكل شركة)
// ==================================================================

model Policy {
  id                    String  @id @default(uuid())

  // ----------------------------------------------------------------
  // 1) حدود الـ Risk Score (0-100)
  //    ملاحظة: CHALLENGE هنا = اختبار متقدم (بعد الـ JS الأساسي)
  // ----------------------------------------------------------------
  allowMaxScore         Int     @default(30)   // 0-30   → ALLOW
  rateLimitMaxScore     Int     @default(60)   // 31-60  → RATE_LIMIT
  challengeMaxScore     Int     @default(80)   // 61-80  → CHALLENGE
  // فوق 80 → BLOCK

  // ----------------------------------------------------------------
  // 2) الاختبار الأساسي (JS Challenge)
  // ----------------------------------------------------------------
  enableJsChallenge     Boolean @default(true)
  challengeAllVisitors  Boolean @default(true)  // true: كل الزوار الجدد | false: المشبوهين بس
  passTokenTtlMinutes   Int     @default(60)    // كام دقيقة يفضل الزائر الناجح من غير اختبار تاني

  // ----------------------------------------------------------------
  // 3) Rate Limit "ناعم" (بيتطبق لما القرار RATE_LIMIT)
  // ----------------------------------------------------------------
  rateLimitRequests     Int     @default(30)   // عدد الطلبات المسموحة
  rateLimitWindowSec    Int     @default(60)   // في كام ثانية

  // ----------------------------------------------------------------
  // 4) الحد الأقصى للطلبات "الصارم" (بيتطبق على أي حد حتى لو الـ Risk منخفض)
  //    الشركة هي اللي تحدد الأرقام دي
  // ----------------------------------------------------------------
  maxRequestsPerIp      Int     @default(300)  // أقصى عدد طلبات من IP واحد
  maxRequestsWindowSec  Int     @default(60)   // خلال كام ثانية
  banOnMaxRequests      Boolean @default(true) // true: حظر مؤقت عند التجاوز | false: 429 لباقي الفترة بس
  maxServerRps          Int?                   // سقف كلي لكل السيرفر (طلب/ثانية)، null = من Server.maxRequestsPerSecond
  capacityWarnPercent   Int     @default(80)   // إشعار لما السيرفر يقرب من السعة

  // ----------------------------------------------------------------
  // 5) الحظر التلقائي
  // ----------------------------------------------------------------
  autoBanAfterFails     Int     @default(2)    // بعد كام فشل اختبار → حظر مؤقت
  temporaryBanMinutes   Int     @default(120)  // ساعتين افتراضي
  permanentBanScore     Int     @default(9)    // لو السمعة (1-10) وصلت 9 أو 10 → دائم

  // ----------------------------------------------------------------
  // 6) تفعيل/تعطيل ميزات
  // ----------------------------------------------------------------
  enableAiAnomaly       Boolean @default(true)
  // enableCollectiveImmunity Boolean @default(true) // ← مش هيستخدم دلوقتي

  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

