// ==================================================================
// NOTIFICATIONS
// ==================================================================

model Notification {
  id          String           @id @default(uuid())
  type        NotificationType
  title       String
  message     String           // ممكن يكون من Gemini
  severity    Int              @default(1) // 1-5
  isRead      Boolean          @default(false)
  metadata    Json?            // بيانات إضافية (IP, Risk Score...)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([organizationId, isRead])
  @@index([createdAt])
}

// ==================================================================
// REPORTS (Gemini)
// ==================================================================

model Report {
  id            String       @id @default(uuid())
  title         String
  status        ReportStatus @default(PENDING)
  periodStart   DateTime
  periodEnd     DateTime
  content       String?      // النص اللي Gemini كتبه
  summary       String?      // ملخص قصير
  errorMessage  String?      // لو status = FAILED
  eventCount    Int          @default(0)
  blockedCount  Int          @default(0)
  metadata      Json?

  // لو التقرير بيشرح حدث واحد بعينه (القسم 8)
  securityEventId String?
  securityEvent   SecurityEvent? @relation(fields: [securityEventId], references: [id], onDelete: SetNull)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([status])
  @@index([securityEventId])
}

// ==================================================================
// SIMULATION LAB
// ==================================================================

model SimulationRun {
  id              String            @id @default(uuid())
  pattern         SimulationPattern
  status          SimulationStatus  @default(RUNNING)
  targetRps       Int               // Requests per second المستهدف
  durationSec     Int?
  totalSent       Int               @default(0)
  totalAllowed    Int               @default(0)
  totalRateLimited Int              @default(0)
  totalChallenged Int               @default(0)
  totalBlocked    Int               @default(0)

  serverId        String
  server          Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  startedAt       DateTime  @default(now())
  stoppedAt       DateTime?

  @@index([organizationId])
  @@index([serverId])
  @@index([status])
}