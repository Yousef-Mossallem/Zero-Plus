# رابط الفرونت (لينك الدعوة)
APP_URL=http://localhost:5173



# ===== Agent — أساسي =====
# طول التوكن بالبايت (32 مناسب)
AGENT_TOKEN_BYTES=32

# بعد كام ثانية نعتبر الـ Agent مش fresh؟
AGENT_FRESH_WINDOW_SEC=120

# فاصل النبضات المقترح للـ Agent (ثواني) — بيتبعت في رد الـ heartbeat
AGENT_HEARTBEAT_INTERVAL_SEC=30

# true فقط في التطوير لو حابب تشوف التوكن من DB
AGENT_STORE_RAW_TOKEN=false

# ===== روابط التحميل / التثبيت =====
# سكربت one-liner (GitHub Release أو سيرفرك)
AGENT_INSTALL_SCRIPT_URL=https://github.com/YOUR_ORG/zero-plus-agent/releases/latest/download/install.sh

# أو قاعدة مشتركة (لو مش محدد SCRIPT_URL هيستخدم base + /install.sh)
AGENT_DOWNLOAD_BASE_URL=https://github.com/YOUR_ORG/zero-plus-agent/releases/latest/download

# صورة Docker
AGENT_DOCKER_IMAGE=ghcr.io/YOUR_ORG/zero-plus-agent:latest

# باينري (مجلد الـ release)
AGENT_BINARY_BASE_URL=https://github.com/YOUR_ORG/zero-plus-agent/releases/latest/download
AGENT_BINARY_NAME=zero-plus-agent

# ===== إيه اللي الـ Agent يتكلم معاه =====
# عنوان الـ API / Gateway العام
AGENT_API_BASE_URL=https://api.your-domain.com

# مسار النبضة (نسبي)
AGENT_HEARTBEAT_PATH=/internal/agent/heartbeat

# وثائق (اختياري — تظهر في رد التفعيل)
AGENT_DOCS_URL=https://docs.your-domain.com/agent

# ===== قوالب أوامر مخصصة (اختياري — أعلى أولوية) =====
# Placeholders: {{TOKEN}} {{API_URL}} {{SERVER_ID}} {{DOMAIN}} {{HEARTBEAT_PATH}}
#               {{SCRIPT_URL}} {{DOCKER_IMAGE}} {{BINARY_BASE}} {{BINARY_NAME}}
# AGENT_INSTALL_CMD_SCRIPT=curl -fsSL "{{SCRIPT_URL}}" | AGENT_TOKEN="{{TOKEN}}" AGENT_API_URL="{{API_URL}}" bash
# AGENT_INSTALL_CMD_DOCKER=docker run -d ... -e AGENT_TOKEN="{{TOKEN}}" "{{DOCKER_IMAGE}}"
# AGENT_INSTALL_CMD_BINARY=...