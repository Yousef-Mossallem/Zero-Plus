// ==================================================================
// Zero Plus - Database Schema
// Auth: WebAuthn / Passkeys
// Agent: Heartbeat + توكن تثبيت + حقول سعة
// Team: مجموعات + صلاحيات JWT + دعوات أعضاء
// Simulation Lab + Origin Probe + Reports + Indexing كامل
// ==================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==================================================================
// ENUMS
// ==================================================================

enum UserRole {
  OWNER
  ADMIN
  ANALYST
  VIEWER
}

enum ServerStatus {
  PENDING
  ONLINE
  DEGRADED
  OFFLINE
  MAINTENANCE
}

enum ServerMode {
  PROTECT
  MONITOR_ONLY
}

enum Decision {
  ALLOW
  MONITOR
  RATE_LIMIT
  CHALLENGE
  BLOCK
}

enum BanStatus {
  NONE
  TEMPORARY
  PERMANENT
}

enum IpType {
  RESIDENTIAL
  MOBILE
  DATACENTER
  VPN_PROXY
  TOR
  UNKNOWN
}

enum ThreatCategory {
  DDOS_BURST
  BOTNET
  BRUTE_FORCE
  SCRAPER
  SUSPICIOUS_BEHAVIOR
  KNOWN_MALICIOUS
  SMOKESCREEN
  OTHER
}

enum NotificationType {
  DDOS_START
  NEW_BLOCK
  CRITICAL_REPUTATION
  SERVER_CAPACITY_WARNING
  SERVER_RECOVERY
  POLICY_CHANGED
  REPORT_READY
  SYSTEM
}

enum ReportStatus {
  PENDING
  GENERATING
  READY
  FAILED
}

enum ReportType {
  PERIODIC
  INCIDENT
  ON_DEMAND
}

enum ChallengeType {
  JS_SILENT
  TLS_FINGERPRINT
  RATE_LIMIT_SOFT
  CAPTCHA_FALLBACK
}

enum DetectionStage {
  BAN_LIST
  PASS_TOKEN
  IP_LOOKUP
  JS_CHALLENGE
  HISTORY_MATCH
  DEEP_COMPARISON
  TLS_FINGERPRINT
  AI_ANOMALY
  HARD_LIMIT
  POLICY
  SURGE_DETECTED
  CLEARANCE_REVOKED
}

enum SimulationPattern {
  REALISTIC_MIX
  LEGIT_ONLY
  LOGIN_FOCUS
  RATE_STRESS
  BOT_WAVE
  BAN_RECOVERY
  FULL_PIPELINE
  CUSTOM
  NORMAL
  SUSPICIOUS_BURST
  REPEATED_REQUESTS
  UNUSUAL_BEHAVIOR
  KNOWN_TEST_SOURCE
}

enum SimulationStatus {
  PENDING
  RUNNING
  STOPPED
  COMPLETED
  FAILED
}

enum SimulationIntensity {
  LOW
  MEDIUM
  HIGH
}

// ==================================================================
// ✅ جديد — ENUMS للـ Agent
// ==================================================================

enum AgentOs {
  LINUX
  WINDOWS
  UNKNOWN
}

// ==================================================================
// ✅ جديد — ENUMS للـ Team & Permissions
// ==================================================================

// حالة دعوة العضو
enum TeamInviteStatus {
  PENDING   // اتبعت، لسه ما اتقبلتش
  ACCEPTED  // اتقبلت وفعّل الـ Passkey
  EXPIRED   // انتهت مدتها
  REVOKED   // المالك ألغاها
}

// ==================================================================
// CORE TENANT
// ==================================================================

model Organization {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  plan        String  @default("free")
  isActive    Boolean @default(true)
  sizeProfile String  @default("medium")

  users             User[]
  servers           Server[]
  securityEvents    SecurityEvent[]
  reputationEntries ReputationEntry[]
  challengeLogs     ChallengeLog[]
  policy            Policy?
  notifications     Notification[]
  reports           Report[]
  simulationRuns    SimulationRun[]

  // ✅ جديد — Team
  permissionGroups    PermissionGroup[]
  teamInvites         TeamInvite[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([isActive])
}

model User {
  id          String    @id @default(uuid())
  email       String    @unique
  fullName    String
  role        UserRole  @default(OWNER)
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
  passwordHash String?
  uiPreferences Json?
acceptedTeamInvites TeamInvite[]
  // ✅ جديد — من دعاه (null = مؤسس الحساب)
  invitedById String?
  invitedBy   User?   @relation("UserInvites", fields: [invitedById], references: [id], onDelete: SetNull)
  invitedUsers User[] @relation("UserInvites")

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  passkeys       PasskeyCredential[]
  passkeyInvites PasskeyInvite[]

  simulationRunsStarted SimulationRun[] @relation("SimulationStartedBy")

  // ✅ جديد — عضويات المجموعات
  groupMemberships    GroupMembership[]

  // ✅ جديد — استثناءات صلاحيات فردية
  permissionOverrides UserPermissionOverride[]

  // ✅ جديد — الدعوات اللي بعتها (كـ Inviter)
  sentInvites TeamInvite[] @relation("InviteSentBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([email])
  @@index([invitedById])
}

// ==================================================================
// AUTH — WebAuthn / Passkeys
// ==================================================================

model PasskeyCredential {
  id           String    @id @default(uuid())
  credentialId String    @unique
  publicKey    Bytes
  counter      Int       @default(0)
  transports   String[]
  deviceName   String?
  aaguid       String?
  lastUsedAt   DateTime?
  isRevoked    Boolean   @default(false)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([credentialId])
}

model PasskeyInvite {
  id        String    @id @default(uuid())
  token     String    @unique
  challenge String?
  expiresAt DateTime
  usedAt    DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([token])
  @@index([userId])
  @@index([expiresAt])
  @@index([usedAt])
  @@index([userId, expiresAt])
}

// ==================================================================
// ✅ جديد — TEAM & PERMISSIONS
//
// الفكرة: كل الصلاحيات بتتحسب وقت إصدار JWT بس.
// الـ jwt.plugin.ts هو الوحيد اللي بيتفحص.
// الموديولات الحالية مش محتاج تتعدّل.
//
// صلاحية = string بالشكل ده:
//   "resource:action"
// أمثلة:
//   "dashboard:view"
//   "servers:view" | "servers:create" | "servers:edit" | "servers:delete"
//   "events:view"
//   "policies:view" | "policies:edit"
//   "reports:view"  | "reports:create"
//   "reputation:view" | "reputation:ban"
//   "simulation:view" | "simulation:run"
//   "team:view" | "team:manage"
//   "settings:view" | "settings:edit"
// ==================================================================

// مجموعة صلاحيات (مثل "Support Team" أو "Read Only")
model PermissionGroup {
  id          String  @id @default(uuid())
  name        String                        // اسم المجموعة
  description String?
  isSystem    Boolean @default(false)       // مجموعات النظام ما تتحذفش

  // قايمة الصلاحيات الممنوحة لهذه المجموعة
  // مخزّنة كـ String[] — مثل ["servers:view", "events:view"]
  permissions String[]

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  members GroupMembership[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([isSystem])
}

// عضوية مستخدم في مجموعة
model GroupMembership {
  id String @id @default(uuid())

  userId  String
  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  groupId String
  group   PermissionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, groupId])
  @@index([userId])
  @@index([groupId])
}

// استثناءات فردية على مستوى مستخدم واحد
// grant = صلاحية زيادة على المجموعة
// deny  = صلاحية مسحوبة حتى لو المجموعة عندها
model UserPermissionOverride {
  id         String @id @default(uuid())
  permission String // مثل "reports:create"
  isDeny     Boolean @default(false) // false = منح | true = سحب

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, permission])
  @@index([userId])
}

// دعوة عضو جديد للمنظمة (بالإيميل + لينك)
// مختلفة عن PasskeyInvite (دي لإضافة جهاز لمستخدم موجود)
model TeamInvite {
  id        String           @id @default(uuid())
  email     String                                 // الإيميل المدعو
  token     String           @unique               // في الرابط
  status    TeamInviteStatus @default(PENDING)
  expiresAt DateTime                               // عادةً 48–72 ساعة
  usedAt    DateTime?

  // الدور الأساسي للعضو الجديد (يتحوّل لصلاحيات بعدين)
  role      UserRole @default(VIEWER)

  // مجموعات مخصصة للعضو الجديد (اختياري)
  // بيتخزن كـ groupIds يتطبقوا بعد القبول
  initialGroupIds String[]

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  invitedById String
  invitedBy   User   @relation("InviteSentBy", fields: [invitedById], references: [id], onDelete: Cascade)

  // المستخدم اللي اتعمل من الدعوة دي (بعد القبول)
  acceptedByUserId String? @unique
 // أزل الـ @relation المخصص من هنا أيضاً ليطابق الطرف الأول:
  acceptedBy       User?   @relation(fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([token])
  @@index([organizationId])
  @@index([status])
  @@index([organizationId, status])
  @@index([expiresAt])
}

// ==================================================================
// PROTECTED SERVERS
// ==================================================================

model Server {
  id         String       @id @default(uuid())
  domain     String       @unique
  originIp   String
  originPort Int          @default(443)
  status     ServerStatus @default(PENDING)
  mode       ServerMode   @default(PROTECT)

  // Origin Probe
  maxRequestsPerSecond  Int?
  safeRequestsPerSecond Int?
  p95ResponseTimeMs     Int?
  loadLatencyP99Ms      Int?
  probeErrorRate        Float?
  probeConfidence       String?
  probeRecommendation   String?
  lastProbeAt           DateTime?

  cpuCores           Int?
  ramMb              Int?
  avgResponseTimeMs  Int?
  currentLoadPercent Float?
  lastHealthCheckAt  DateTime?

  verificationToken String    @default(uuid())
  dnsVerified       Boolean   @default(false)
  dnsVerifiedAt     DateTime?
  gatewayReachable  Boolean   @default(false)
  originReachable   Boolean   @default(false)
  sslEnabled        Boolean   @default(true)

  // ✅ جديد — Agent fields
  // التوكن اللي بيتعمل مرة واحدة وبيتبعت في أمر التثبيت
  agentToken        String?   @unique
  // hash للتوكن (أكثر أماناً من تخزين النص الخام)
  agentTokenHash    String?   @unique
  // إصدار الـ Agent المركّب على سيرفر العميل
  agentVersion      String?
  // نظام التشغيل والمعمارية
  agentOs           AgentOs?
  agentArch         String?   // amd64 | arm64
  // آخر نبضة وصلت
  lastAgentAt       DateTime?
  // هل النفق شغال؟
  tunnelUp          Boolean   @default(false)
  // IP peer داخل النفق (من WireGuard)
  tunnelPeerIp      String?
  // آخر لقطة مقاييس
  agentCpuPercent   Float?
  agentRamPercent   Float?
  agentDiskPercent  Float?
  agentLoadAvg1m    Float?
  // سعة تقديرية من الـ Agent
  estimatedMaxRps   Int?
  // هل الأصل شغال من منظور الـ Agent
  agentOriginOk     Boolean?
  agentOriginLatMs  Int?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  securityEvents SecurityEvent[]
  simulationRuns SimulationRun[]
  challengeLogs  ChallengeLog[]
  probeRuns      ServerProbeRun[]
  reports        Report[]

  // ✅ جديد — سجل نبضات الـ Agent
  agentHeartbeats AgentHeartbeat[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([status])
  @@index([lastProbeAt])
  // ✅ جديد
  @@index([lastAgentAt])
  @@index([tunnelUp])
  @@index([organizationId, tunnelUp])
}

// ==================================================================
// ✅ جديد — AGENT HEARTBEAT HISTORY
// كل نبضة بتتسجل هنا للتسعير وتحليل الأداء
// Server بيحتفظ بآخر قيم كـ snapshot للسرعة
// ==================================================================

model AgentHeartbeat {
  id String @id @default(uuid())

  // هوية
  agentVersion String?
  agentOs      AgentOs?
  agentArch    String?
  hostname     String?

  // نفق
  tunnelUp          Boolean @default(false)
  lastHandshakeAgeSec Int?   // ثواني منذ آخر WG handshake
  tunnelTxBytes     BigInt? // تراكمي
  tunnelRxBytes     BigInt? // تراكمي

  // مقاييس
  cpuPercent    Float?
  ramPercent    Float?
  diskPercent   Float?
  loadAvg1m     Float?
  netTxBytesPs  Float? // بايت/ث منذ آخر نبضة
  netRxBytesPs  Float?

  // صحة الأصل
  originOk      Boolean?
  originLatMs   Int?

  // تقدير السعة (من الـ Agent نفسه — اختياري)
  suggestedMaxRps Int?

  serverId String
  server   Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([serverId, createdAt])
  @@index([serverId, tunnelUp])
  // للتسعير: نطاق زمني لسيرفر معين
  @@index([serverId, createdAt, cpuPercent])
}

// ==================================================================
// ORIGIN PROBE HISTORY
// ==================================================================

model ServerProbeRun {
  id             String  @id @default(uuid())
  maxRps         Int?
  safeRps        Int?
  p95Ms          Int?
  p99LoadMs      Int?
  errorRate      Float?
  confidence     String?
  recommendation String?
  details        Json?

  createdAt DateTime @default(now())

  serverId String
  server   Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId, createdAt])
}

// ==================================================================
// REPUTATION
// ==================================================================

model ReputationEntry {
  id                String    @id @default(uuid())
  ipAddress         String
  deviceFingerprint String?
  ja3Fingerprint    String?
  ja4Fingerprint    String?
  countryCode       String?
  asn               Int?
  asOrg             String?
  ipType            IpType    @default(UNKNOWN)

  score              Int       @default(1)
  banStatus          BanStatus @default(NONE)
  bannedUntil        DateTime?
  bannedAt           DateTime?
  banReason          String?
  isManualBan        Boolean   @default(false)
  isAllowlisted      Boolean   @default(false)

  failedChecksCount  Int @default(0)
  jsFailCount        Int @default(0)
  advancedFailCount  Int @default(0)
  collectiveHitCount Int @default(0)
  successfulChecks   Int @default(0)
  totalRequests      Int @default(0)

  lastFailedAt   DateTime?
  lastPath       String?
  lastUserAgent  String?
  avgRequestRate Float?
  isKnownBotnet  Boolean @default(false)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  securityEvents SecurityEvent[]
  challenges     ChallengeLog[]

  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([organizationId, ipAddress])

  @@index([organizationId])
  @@index([banStatus])
  @@index([bannedUntil])
  @@index([score])
  @@index([deviceFingerprint])
  @@index([ja3Fingerprint])
  @@index([ja4Fingerprint])
  @@index([ipType])
  @@index([isAllowlisted])
  @@index([isKnownBotnet])
  @@index([isManualBan])
  @@index([updatedAt])
  @@index([lastSeenAt])
  @@index([updatedAt, id])
  @@index([organizationId, updatedAt])
  @@index([organizationId, updatedAt, id])
  @@index([banStatus, bannedUntil])
  @@index([organizationId, banStatus, bannedUntil])
  @@index([isAllowlisted, updatedAt])
  @@index([organizationId, isAllowlisted])
  @@index([organizationId, score])
  @@index([organizationId, banStatus])
  @@index([organizationId, lastSeenAt])
  @@index([organizationId, isKnownBotnet])
  @@index([organizationId, isManualBan])
  @@index([organizationId, ipType])
  @@index([organizationId, countryCode])
  @@index([organizationId, deviceFingerprint])
}

// ==================================================================
// SECURITY EVENTS
// ==================================================================

model SecurityEvent {
  id               String         @id @default(uuid())
  ipAddress        String
  path             String
  method           String
  userAgent        String?
  referer          String?
  requestId        String?

  riskScore        Int
  anomalyScore     Float?
  confidence       Float?
  decision         Decision
  decidedAtStage   DetectionStage?
  reasonSummary    String?
  reasonDetails    Json?
  processingTimeMs Int?

  surgeDetected Boolean @default(false)
  pathSensitive Boolean @default(false)
  recommendation String?

  countryCode String?
  asn         Int?
  ipType      IpType?

  isChallenged    Boolean       @default(false)
  challengeType   ChallengeType?
  challengePassed Boolean?

  simulationRunId String?
  simulationRun   SimulationRun? @relation(fields: [simulationRunId], references: [id], onDelete: SetNull)

  serverId String
  server   Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  reputationEntryId String?
  reputationEntry   ReputationEntry? @relation(fields: [reputationEntryId], references: [id])

  reports Report[]

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([serverId])
  @@index([ipAddress])
  @@index([decision])
  @@index([riskScore])
  @@index([createdAt])
  @@index([reputationEntryId])
  @@index([organizationId, createdAt])
  @@index([serverId, createdAt])
  @@index([organizationId, decision, createdAt])
  @@index([organizationId, serverId, createdAt])
  @@index([organizationId, ipAddress, createdAt])
  @@index([simulationRunId])
  @@index([simulationRunId, createdAt])
}

// ==================================================================
// CHALLENGE LOGS
// ==================================================================

model ChallengeLog {
  id              String        @id @default(uuid())
  challengeType   ChallengeType
  passed          Boolean
  durationMs      Int?
  failureReason   String?
  reputationDelta Int           @default(0)

  reputationEntryId String
  reputationEntry   ReputationEntry @relation(fields: [reputationEntryId], references: [id], onDelete: Cascade)

  serverId String?
  server   Server? @relation(fields: [serverId], references: [id], onDelete: SetNull)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([reputationEntryId])
  @@index([organizationId])
  @@index([serverId])
  @@index([passed])
  @@index([organizationId, createdAt])
  @@index([reputationEntryId, createdAt])
}

// ==================================================================
// POLICIES
// ==================================================================

model Policy {
  id String @id @default(uuid())

  allowMaxScore     Int @default(30)
  rateLimitMaxScore Int @default(60)
  challengeMaxScore Int @default(80)

  enableJsChallenge    Boolean @default(true)
  challengeAllVisitors Boolean @default(true)
  passTokenTtlMinutes  Int     @default(60)

  rateLimitRequests  Int @default(30)
  rateLimitWindowSec Int @default(60)

  maxRequestsPerIp     Int     @default(300)
  maxRequestsWindowSec Int     @default(60)
  banOnMaxRequests     Boolean @default(true)

  maxServerRps        Int?
  capacityWarnPercent Int  @default(80)

  autoBanAfterFails   Int @default(2)
  temporaryBanMinutes Int @default(120)
  advancedBanMinutes  Int @default(1440)
  permanentBanScore   Int @default(9)

  enableAiAnomaly      Boolean @default(true)
  enableSurgeDetection Boolean @default(true)

  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==================================================================
// NOTIFICATIONS
// ==================================================================

model Notification {
  id       String           @id @default(uuid())
  type     NotificationType
  title    String
  message  String
  severity Int              @default(1)
  isRead   Boolean          @default(false)
  metadata Json?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([organizationId, isRead])
  @@index([createdAt])
  @@index([organizationId, createdAt])
}

// ==================================================================
// REPORTS
// ==================================================================

model Report {
  id           String       @id @default(uuid())
  title        String
  type         ReportType   @default(ON_DEMAND)
  status       ReportStatus @default(PENDING)
  periodStart  DateTime
  periodEnd    DateTime
  content      String?
  summary      String?
  errorMessage String?

  eventCount   Int    @default(0)
  blockedCount Int    @default(0)
  tokensUsed   Int?
  modelUsed    String?
  metadata     Json?

  serverId String?
  server   Server? @relation(fields: [serverId], references: [id], onDelete: SetNull)

  securityEventId String?
  securityEvent   SecurityEvent? @relation(fields: [securityEventId], references: [id], onDelete: SetNull)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([status])
  @@index([securityEventId])
  @@index([serverId])
  @@index([organizationId, createdAt])
  @@index([organizationId, type])
}

// ==================================================================
// SIMULATION LAB
// ==================================================================

model SimulationRun {
  id String @id @default(uuid())

  pattern   SimulationPattern
  status    SimulationStatus    @default(PENDING)
  intensity SimulationIntensity @default(MEDIUM)

  targetRps   Int
  maxRps      Int @default(40)
  durationSec Int @default(60)

  totalSent        Int  @default(0)
  totalAllowed     Int  @default(0)
  totalRateLimited Int  @default(0)
  totalChallenged  Int  @default(0)
  totalBlocked     Int  @default(0)
  totalFailed      Int  @default(0)
  avgLatencyMs     Int?

  options Json?

  tokenJti       String?   @unique
  tokenExpiresAt DateTime?

  errorMessage String?

  serverId String
  server   Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  startedByUserId String?
  startedBy       User?   @relation("SimulationStartedBy", fields: [startedByUserId], references: [id], onDelete: SetNull)

  securityEvents SecurityEvent[]

  startedAt DateTime  @default(now())
  stoppedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([organizationId])
  @@index([serverId])
  @@index([status])
  @@index([organizationId, startedAt])
  @@index([organizationId, status])
  @@index([startedByUserId])
}
